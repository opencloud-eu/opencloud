{
  // This file must be named biome.jsonc, not biome.json. Comments in a file
  // named biome.json are not reported as an error: Biome silently discards the
  // whole configuration and runs on defaults instead.
  "$schema": "./node_modules/@biomejs/biome/configuration_schema.json",

  "files": {
    // Scoped explicitly rather than through ignore files, so an untracked
    // directory in a working tree cannot change what lint reports. These
    // exclusions carry over the ones .eslintignore used to hold, plus the
    // locale JSON that make -C i18n generates from the .po files.
    "includes": [
      "**",
      // Bare folder names, not "folder/**": that lets the scanner skip the
      // directory instead of matching every path inside it.
      "!build",
      "!dist",
      "!coverage",
      "!releases",
      "!src/locales/locales.json",
      "!src/locales/*/translation.json",
      // The SVGs are image assets, reached by URL from CSS and from an img tag,
      // never inlined into JSX. Biome's SVG rules assume the inline case, so
      // they ask a background image for a title element. src/images/app-icon.svg
      // is also generated by src/images/Makefile and gitignored, and linting a
      // file that may or may not exist in a working tree is exactly what the
      // explicit scoping above is meant to prevent.
      "!**/*.svg"
    ]
  },

  "formatter": {
    "enabled": true,
    // Stated here rather than read from .editorconfig. Biome only looks for
    // that file in its own root, which is this directory, and the repository's
    // copy sits a level up where Biome never sees it; with useEditorconfig on
    // and nothing found, the default is a tab. These are what the root file
    // asks for the TypeScript and CSS sources, and what they already used.
    "indentStyle": "space",
    "indentWidth": 2,
    // 120 is what the repository's root ESLint config asked for.
    "lineWidth": 120
  },

  "javascript": {
    "formatter": {
      // Stated rather than left to the default, so the choice survives a change
      // of Biome's own default.
      "quoteStyle": "double"
    }
  },

  "css": {
    "formatter": {
      "quoteStyle": "double"
    }
  },

  "linter": {
    "enabled": true,
    "domains": {
      "react": "recommended",
      "test": "recommended"
    },
    "rules": {
      // "preset" supersedes the deprecated "recommended": true.
      "preset": "recommended"
    }
  },

  "assist": {
    "enabled": true,
    "actions": {
      "source": {
        "organizeImports": {
          "level": "on",
          "options": {
            // The grouping the sources already followed: react first, then
            // everything else installed, then MUI, then relative paths, each
            // separated by a blank line.
            "groups": [
              ["react", "react-*", "react-*/**"],
              ":BLANK_LINE:",
              [":PACKAGE:", "!@mui/**"],
              ":BLANK_LINE:",
              ["@mui/**"],
              ":BLANK_LINE:",
              [":PATH:"]
            ]
          }
        }
      }
    }
  }
}
