# EditorConfig is awesome: http://EditorConfig.org

# top-most EditorConfig file
root = true

# Unix-style newlines with a newline ending every file
[*]
charset = utf-8
indent_style = tab
indent_size = 4
insert_final_newline = true
trim_trailing_whitespace = true

; Python: PEP8 defines 4 spaces for indentation
[*.py]
indent_style = space
indent_size = 4

; YAML and JSON, 2 spaces
[*.{yaml,yml,yaml.in,json,jsonc}]
indent_style = space
indent_size = 2

; HTML, CSS and JavaScript, 2 spaces. The module extensions are listed too,
; because the section above applies to whatever the formatter is pointed at and
; a config file left to the catch-all would be indented with tabs.
[*.{html,css,js,mjs,cjs,ts,mts,cts,tsx,jsx}]
charset = utf-8
indent_size = 2
indent_style = space
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
